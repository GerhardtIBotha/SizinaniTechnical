@page
@model IndexModel

@if (Model.Message != null)
{
    <div class="alert alert-success">@Model.Message</div>
}

<form method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-2">
        <label asp-for="Input.Type"></label>
        <input asp-for="Input.Type" class="form-control" />
        <span asp-validation-for="Input.Type" class="text-danger"></span>
    </div>
    <div class="mb-2">
        <label asp-for="Input.RegistrationNr"></label>
        <input asp-for="Input.RegistrationNr" class="form-control" />
        <span asp-validation-for="Input.RegistrationNr" class="text-danger"></span>
    </div>
    <div class="mb-2">
        <label asp-for="Input.Model"></label>
        <input asp-for="Input.Model" class="form-control" />
        <span asp-validation-for="Input.Model" class="text-danger"></span>
    </div>
    <div class="mb-2">
        <label asp-for="Input.Weight"></label>
        <input asp-for="Input.Weight" class="form-control" />
    </div>

    <button type="submit" class="btn btn-primary">Save</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />}